import { LapManager } from './LapManager.js';
import * as THREE from 'three';
import { createCar } from './Car.js';
import { createTrack } from './Track.js';

export class Race {
  constructor(container) {
    this.container = container;

    this.scene = new THREE.Scene();
    this.scene.background = new THREE.Color(0x050510);
    this.scene.fog = new THREE.Fog(0x050510, 40, 180);

    this.camera = new THREE.PerspectiveCamera(
      65,
      window.innerWidth / window.innerHeight,
      0.1,
      500
    );

    this.renderer = new THREE.WebGLRenderer({
      antialias: true
    });

    this.renderer.setSize(
      window.innerWidth,
      window.innerHeight
    );

    this.renderer.setPixelRatio(
      Math.min(window.devicePixelRatio, 2)
    );

    this.container.appendChild(this.renderer.domElement);

    this.scene.add(
      new THREE.HemisphereLight(0x00eaff, 0x110022, 2)
    );

    const light = new THREE.DirectionalLight(0xffffff, 2);
    light.position.set(10, 20, 10);
    this.scene.add(light);

    createTrack(this.scene);

    this.car = createCar();
    this.car.position.set(35, 0, 0);
    this.car.rotation.y = Math.PI;
    this.scene.add(this.car);

    this.lapManager = new LapManager(3);
    this.previousCarPosition = this.car.position.clone();

    this.keys = {};
    this.speed = 0;
    this.maxSpeed = 0.65;
    this.acceleration = 0.012;
    this.friction = 0.006;

    this.clock = new THREE.Clock();

    this.elapsedTime = 0;
    this.nitro = 100;
    this.nitroActive = false;

    this.onKeyDown = (event) => {
      this.keys[event.code] = true;

      if ([
        'ArrowUp',
        'ArrowDown',
        'ArrowLeft',
        'ArrowRight',
        'Space'
      ].includes(event.code)) {
        event.preventDefault();
      }
    };

    this.onKeyUp = (event) => {
      this.keys[event.code] = false;
    };

    this.onResize = () => {
      this.camera.aspect =
        window.innerWidth / window.innerHeight;

      this.camera.updateProjectionMatrix();

      this.renderer.setSize(
        window.innerWidth,
        window.innerHeight
      );
    };

    window.addEventListener('keydown', this.onKeyDown);
    window.addEventListener('keyup', this.onKeyUp);
    window.addEventListener('resize', this.onResize);

    this.running = true;
    this.animate();
  }

  update(delta) {
    const step = Math.min(delta * 60, 2);

    this.elapsedTime += delta;

    const minutes = Math.floor(this.elapsedTime / 60);
    const seconds = Math.floor(this.elapsedTime % 60);

    const timerElement = document.getElementById('raceTime');

    if (timerElement) {
      timerElement.textContent =
        String(minutes).padStart(2, '0') + ':' +
        String(seconds).padStart(2, '0');
    }

    this.nitroActive =
      this.keys['Space'] &&
      this.nitro > 0 &&
      this.speed > 0.05;

    if (this.nitroActive) {
      this.nitro = Math.max(0, this.nitro - 25 * delta);
    } else {
      this.nitro = Math.min(100, this.nitro + 8 * delta);
    }

    const nitroFill = document.getElementById('nitroFill');

    if (nitroFill) {
      nitroFill.style.width = this.nitro + '%';
    }

    if (this.keys['KeyW'] || this.keys['ArrowUp']) {
      this.speed += this.acceleration * step;
    } else if (this.keys['KeyS'] || this.keys['ArrowDown']) {
      this.speed -= this.acceleration * step;
    } else {
      if (this.speed > 0) {
        this.speed = Math.max(
          0,
          this.speed - this.friction * step
        );
      } else {
        this.speed = Math.min(
          0,
          this.speed + this.friction * step
        );
      }
    }

    const currentMaxSpeed = this.nitroActive
      ? this.maxSpeed * 1.6
      : this.maxSpeed;

    this.speed = THREE.MathUtils.clamp(
      this.speed,
      -this.maxSpeed / 2,
      currentMaxSpeed
    );

    const steering = 0.025 * step;

    if (Math.abs(this.speed) > 0.01) {
      if (this.keys['KeyA'] || this.keys['ArrowLeft']) {
        this.car.rotation.y += steering;
      }

      if (this.keys['KeyD'] || this.keys['ArrowRight']) {
        this.car.rotation.y -= steering;
      }
    }

    this.car.translateZ(-this.speed * step);

    // Comprobar el avance por el circuito
    this.updateLaps();


    // Actualizar indicador de velocidad
    const speedElement = document.getElementById('speedValue');

    if (speedElement) {
      const kmh = Math.round(Math.abs(this.speed) * 300);
      speedElement.textContent = kmh;
    }

    // Cámara de persecución
    const cameraOffset = new THREE.Vector3(0, 5, 10);
    cameraOffset.applyQuaternion(this.car.quaternion);

    const desiredPosition = this.car.position
      .clone()
      .add(cameraOffset);

    this.camera.position.lerp(
      desiredPosition,
      Math.min(0.08 * step, 1)
    );

    const lookTarget = this.car.position.clone();
    lookTarget.y += 1;

    this.camera.lookAt(lookTarget);
  }

  animate() {
    if (!this.running) return;

    const delta = this.clock.getDelta();

    this.update(delta);
    this.renderer.render(this.scene, this.camera);

    this.animationId = requestAnimationFrame(
      () => this.animate()
    );
  }

  updateLaps() {
    const position = this.car.position;
    const previous = this.previousCarPosition;

    // Puntos de control provisionales del circuito.
    // Se validarán con la geometría real de la pista.
    if (position.z > 55) {
      this.lapManager.visitCheckpoint('north');
    }

    if (position.x < -25) {
      this.lapManager.visitCheckpoint('west');
    }

    if (position.z < -55) {
      this.lapManager.visitCheckpoint('south');
    }

    // Línea de meta provisional: x = 35, avanzando hacia z positivo.
    const crossedFinish =
      previous.z < 0 &&
      position.z >= 0 &&
      position.x > 25 &&
      position.x < 45;

    if (crossedFinish) {
      const result = this.lapManager.crossFinishLine();

      if (result.valid) {
        console.log(
          `🏁 Vuelta completada: ${this.lapManager.completedLaps}`
        );
      }
    }

    const lapElement = document.getElementById('lapValue');

    if (lapElement) {
      lapElement.textContent =
        `${this.lapManager.currentLap}/${this.lapManager.totalLaps}`;
    }

    this.previousCarPosition.copy(position);
  }

  reset() {
    this.car.position.set(35, 0, 0);
    this.car.rotation.set(0, Math.PI, 0);

    this.lapManager.reset();
    this.previousCarPosition.copy(this.car.position);

    const lapElement = document.getElementById('lapValue');

    if (lapElement) {
      lapElement.textContent = '1/3';
    }

    this.speed = 0;
    this.nitro = 100;
    this.nitroActive = false;
    this.elapsedTime = 0;
    this.keys = {};

    this.camera.position.set(0, 5, 20);
    this.camera.lookAt(this.car.position);
  }

  destroy() {
    this.running = false;

    cancelAnimationFrame(this.animationId);

    window.removeEventListener('keydown', this.onKeyDown);
    window.removeEventListener('keyup', this.onKeyUp);
    window.removeEventListener('resize', this.onResize);

    this.scene.traverse((object) => {
      if (object.geometry) {
        object.geometry.dispose();
      }

      if (object.material) {
        const materials = Array.isArray(object.material)
          ? object.material
          : [object.material];

        materials.forEach((material) => material.dispose());
      }
    });

    this.renderer.dispose();
    this.renderer.domElement.remove();
  }
}
